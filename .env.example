# Puerto de la API interna para comunicación con facturador-sv
PORT=3005

# Conexión a la base de datos PostgreSQL de facturador-sv
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=facturador_db
# Alternativa: DATABASE_URL=postgres://postgres:secret@localhost:5432/facturador_db

# Directorio de persistencia de sesiones de Baileys
SESSIONS_DIR=./sessions_data

# Configuración de almacenamiento para adjuntos de facturas (PDF / JSON)
USE_B2_STORAGE=false
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_KEY_ID=tu_b2_key_id
B2_APPLICATION_KEY=tu_b2_application_key
B2_BUCKET_NAME=tu_bucket

# Ruta local si los archivos se almacenan en disco local (desarrollo)
LOCAL_STORAGE_BASE_PATH=../facturador-sv
